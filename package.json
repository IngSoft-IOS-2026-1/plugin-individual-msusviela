{
  "name": "miranda-static-helper",
  "displayName": "Miranda Static Helper",
  "description": "Basic language support and lightweight static analysis for Miranda in VS Code.",
  "version": "1.0.0",
  "publisher": "msusviela",
  "icon": "assets/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IngSoft-IOS-2026-1/plugin-individual-msusviela.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "files": [
    "out/**",
    "assets/**",
    "syntaxes/**",
    "language-configuration.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "miranda",
        "aliases": [
          "Miranda",
          "miranda"
        ],
        "extensions": [
          ".m"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "miranda",
        "scopeName": "source.miranda",
        "path": "./syntaxes/miranda.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mirandaStaticHelper.analyzeCurrentFile",
        "title": "Miranda: Analyze Current File"
      }
    ],
    "configuration": {
      "title": "Miranda Static Helper",
      "properties": {
        "mirandaStaticHelper.rules": {
          "type": "object",
          "description": "Per-rule configuration. Keys are diagnostic codes and values are 'off', 'warn' (or 'warning'), or 'error'.",
          "additionalProperties": {
            "type": "string",
            "enum": ["off", "warn", "warning", "error"]
          },
          "default": {}
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:vsix": "vsce package --no-dependencies --allow-missing-repository",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.3.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3",
    "vscode": "^1.1.37"
  }
}
